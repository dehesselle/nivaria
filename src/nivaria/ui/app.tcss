/* ---- main screen: tree / detail, mouse-resizable -------------------- */

MainScreen {
    layout: horizontal;
}

#tree {
    width: 1fr;
    height: 1fr;
    border: round $panel;
}

#detail {
    width: 3fr;
    height: 1fr;
    border: round $panel;
}

#tree:focus-within,
#detail:focus-within {
    border: round $accent;
}

/* ---- connect screen: form left, recents right ------------------------- */

ConnectScreen {
    align: center middle;
}

#connect {
    layout: horizontal;
    /* Sized to the content it wants, but never larger than the terminal it
       is in: a fixed 90x24 was clipped on both axes at 80x24. */
    width: 90;
    max-width: 100%;
    height: 25;
    max-height: 100%;
    border: thick $background 80%;
    background: $surface;
}

#connect-form {
    width: 3fr;
    padding: 1 2;
}

#connect-recent {
    width: 2fr;
    border-left: solid $panel;
    padding: 1 2;
}

#connect-title {
    text-style: bold;
}

#connect-fields {
    margin-top: 1;
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#connect-identity {
    height: auto;
}

#connect-identity Input,
#connect-identity Select {
    width: 1fr;
}

#connect-optional {
    height: auto;
}

#connect-optional Input {
    width: 1fr;
}

#connect-status {
    height: 1;
    color: $text-muted;
}

#connect-buttons {
    height: auto;
    align-horizontal: right;
}

#connect-buttons Button {
    margin: 0 0 0 1;
}

#recent-list,
#recent-empty {
    margin-top: 1;
}

/* ---- picker modal ----------------------------------------------------- */

PickerDialog > #dialog,
MultiPickerDialog > #dialog {
    width: 70;
    max-height: 80%;
}

#picker-query {
    margin: 1 0;
}

#picker-results {
    height: auto;
    max-height: 20;
}

/* MultiPickerDialog only: PickerDialog has no button row. */
MultiPickerDialog #buttons {
    margin-top: 1;
}

/* Textual's Button defaults to min-width: 16 even when compact, which is
   more than "All"/"None"/"Ok"/"Cancel" ever need -- four of them plus
   margins came within a few cells of the dialog's own width, leaving no
   visible gap for align-horizontal: right (inherited from Dialog) to
   show. Trimmed by 4 to 12, still comfortably wider than the longest label
   ("Cancel") needs. */
MultiPickerDialog #buttons Button {
    min-width: 12;
}

/* ---- connecting modal --------------------------------------------------- */

ConnectingDialog > #dialog {
    width: 46;
    max-width: 100%;
}

#connecting-hint {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
}

/* ---- closing modal ------------------------------------------------------ */

ClosingDialog > #dialog {
    width: 46;
    max-width: 100%;
}

#closing-hint {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
}

/* ---- status footer ----------------------------------------------------- */

/* Colours and padding come from tcoda's `FooterStatus > *`. Only the countdown's
   fixed width is ours: at three digits plus a cell either side the box does
   not resize, so the digits don't visibly shift as the count drops. */
#footer-countdown { width: 5; text-align: right; }

/* ---- detail pane and views -------------------------------------------- */

#detail-columns {
    height: 1fr;
}

.detail-placeholder {
    padding: 1 2;
    color: $text-muted;
}

#detail-history,
#detail-grants,
#detail-data {
    height: 1fr;
}

/* A table plus the panel under it (tables.PanelledTable): the table takes
   whatever the panel leaves. */
.panelled-table {
    height: 1fr;
}

/* A class, not an id: the Table view holds two panels, one per tab. */
.detail-item {
    height: auto;
    max-height: 8;
    padding: 0 1;
    /* Textual's default overflow-y is hidden, which would clip a column
       with more tags than fit -- silently, with no scrollbar and no hint
       anything was cut off. auto scrolls instead, the same way any
       taller-than-its-box widget here does. */
    overflow-y: auto;
}

/* Only PipeView/TaskView's panel carries this -- it only ever shows a load/
   run error. The column-tags and grants panels stay the default text
   color. */
.detail-item.-error {
    color: $error;
}

/* A banner about the fetch behind the table below it -- capped, empty or
   errored. A tinted strip rather than inverted, which would read as the
   table's row cursor one line below. A share of $foreground rather than a
   panel colour, so it lifts off the background in light and dark themes
   alike -- $boost, the stock version of this, is too faint to see on a
   light one. The gap below keeps it from running into the table header's
   own tint. No padding, so the text starts in the same column as the
   header's first label.

   The unmarked default is the empty case: a category or history window that
   was fetched and came back empty is a settled, unremarkable fact, not a
   warning -- same $text-muted reasoning .detail-placeholder and
   #connect-status already use. */
#detail-list-note,
#detail-status-note,
#detail-history-note,
#detail-data-note {
    height: auto;
    margin-bottom: 1;
    background: $foreground 8%;
    color: $text-muted;
}

/* Not $error: a capped history is correct data, just not all of it. */
#detail-history-note.-capped {
    color: $text-warning;
}

#detail-list-note.-error,
#detail-status-note.-error,
#detail-history-note.-error,
#detail-data-note.-error {
    color: $text-error;
}

#detail-sql {
    height: 1fr;
}

/* ---- search modal: 90% of the screen, room for a lot of matches -------- */

SearchDialog > #dialog {
    width: 90%;
    height: 90%;
}

SearchDialog #search-query {
    /* Input's default border needs three rows to show anything inside it;
       squeezing that to one row without dropping the border first left the
       text and cursor with nowhere to actually paint. */
    border: none;
    height: 1;
    padding: 0 1;
    background: $panel;
    margin-bottom: 1;
}

SearchDialog #search-results {
    height: 1fr;
}
