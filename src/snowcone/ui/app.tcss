/* ---- main screen: 25% tree / 75% detail, split 25/75 vertically ------- */

MainScreen {
    layout: horizontal;
}

#left {
    width: 1fr;
}

#right {
    width: 3fr;
}

#tree {
    height: 1fr;
    border: round $panel;
}

#context {
    height: 1fr;
    border: round $panel;
}

#detail {
    height: 3fr;
    border: round $panel;
}

#tree:focus-within,
#context:focus-within,
#detail:focus-within {
    border: round $accent;
}

/* ---- connect screen: form left, recents right ------------------------- */

ConnectScreen {
    align: center middle;
}

#connect {
    layout: horizontal;
    /* Sized to the content it wants, but never larger than the terminal it
       is in: a fixed 90x24 was clipped on both axes at 80x24. */
    width: 90;
    max-width: 100%;
    height: 24;
    max-height: 100%;
    border: thick $background 80%;
    background: $surface;
}

#connect-form {
    width: 3fr;
    padding: 1 2;
}

#connect-recent {
    width: 2fr;
    border-left: solid $panel;
    padding: 1 2;
}

#connect-title {
    text-style: bold;
}

#connect-fields {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#connect-optional {
    height: auto;
}

#connect-optional Input {
    width: 1fr;
}

#connect-status {
    height: 1;
    color: $text-muted;
}

#connect-buttons {
    height: auto;
    align-horizontal: right;
}

#connect-buttons Button {
    margin: 0 0 0 1;
}

#recent-list,
#recent-empty {
    margin-top: 1;
}

/* ---- picker modal ----------------------------------------------------- */

PickerScreen > #dialog {
    width: 70;
    max-height: 80%;
}

#picker-query {
    margin: 1 0;
}

#picker-results {
    height: auto;
    max-height: 20;
}

/* ---- confirm modal ----------------------------------------------------- */

ConfirmScreen > #dialog {
    width: 60;
    max-width: 100%;
}

#confirm-message {
    margin: 1 0;
}

/* ---- status footer ---------------------------------------------------- */

StatusFooter .footer-spacer {
    width: 1fr;
    height: 1;
}

StatusFooter #footer-countdown {
    /* Fixed at three digits plus a cell of padding either side, so the
       figures do not shift as the count drops from 3 digits to 2 to 1. */
    width: 5;
    height: 1;
    padding: 0 1;
    text-align: right;
    color: $footer-description-foreground;
    background: $footer-description-background;
}

StatusFooter #footer-pool {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $footer-description-foreground;
    background: $footer-description-background;
}

/* ---- detail pane and views -------------------------------------------- */

#context-bar {
    height: auto;
    padding: 0 1;
}

#context-title {
    text-style: bold;
}

#context-detail {
    color: $text-muted;
}

#detail-summary {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#detail-columns {
    height: 1fr;
}

#detail-placeholder {
    padding: 1 2;
    color: $text-muted;
}

#pipe-problem {
    height: auto;
    padding: 0 1;
    color: $error;
    text-style: bold;
}

#pipe-facts {
    height: auto;
    padding: 1;
}

#pipe-definition-label {
    padding: 0 1;
    text-style: bold;
}

#pipe-definition {
    height: 1fr;
    padding: 0 1;
    color: $text-muted;
}

/* ---- search ----------------------------------------------------------- */

#search {
    height: auto;
}

#search-query {
    border: none;
    height: 1;
    padding: 0 1;
    background: $panel;
}

#search-query:focus {
    background: $boost;
}

#search-results {
    height: auto;
    max-height: 12;
    border: none;
    background: $surface;
}
