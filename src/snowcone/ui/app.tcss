/* ---- main screen: 25% tree / 75% detail, split 25/75 vertically ------- */

MainScreen {
    layout: horizontal;
}

#left {
    width: 1fr;
}

#right {
    width: 3fr;
}

#tree {
    height: 1fr;
    border: round $panel;
}

#context {
    height: 1fr;
    border: round $panel;
}

#detail {
    height: 3fr;
    border: round $panel;
}

#tree:focus-within,
#context:focus-within,
#detail:focus-within {
    border: round $accent;
}

/* ---- connect screen: form left, recents right ------------------------- */

ConnectScreen {
    align: center middle;
}

#connect {
    layout: horizontal;
    /* Sized to the content it wants, but never larger than the terminal it
       is in: a fixed 90x24 was clipped on both axes at 80x24. */
    width: 90;
    max-width: 100%;
    height: 24;
    max-height: 100%;
    border: thick $background 80%;
    background: $surface;
}

#connect-form {
    width: 3fr;
    padding: 1 2;
}

#connect-recent {
    width: 2fr;
    border-left: solid $panel;
    padding: 1 2;
}

#connect-title {
    text-style: bold;
}

#connect-fields {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#connect-identity {
    height: auto;
}

#connect-identity Input,
#connect-identity Select {
    width: 1fr;
}

#connect-optional {
    height: auto;
}

#connect-optional Input {
    width: 1fr;
}

#connect-status {
    height: 1;
    color: $text-muted;
}

#connect-buttons {
    height: auto;
    align-horizontal: right;
}

#connect-buttons Button {
    margin: 0 0 0 1;
}

#recent-list,
#recent-empty {
    margin-top: 1;
}

/* ---- buttons ------------------------------------------------------------ */

/* The unstyled (default) variant defaults to $surface, which sits so close
   to the screen background and to $panel that it visually disappears next
   to a -primary sibling. Bump it up the existing gray ramp instead of
   introducing a new color.
   Marked explicitly with a "button-gray" class from the call site rather
   than matched by variant: a "default" variant Button's `variant` reactive
   is declared with "default" as its initial value, and Textual only calls
   watch_variant() on an actual change, so a button that is never given
   another variant never gets a "-default" class added at all -- there is no
   selector that means "whichever variant this is, it isn't -primary/
   -success/-warning/-error" since Textual's CSS has no :not(), and any rule
   here in app.tcss outranks Button's own DEFAULT_CSS regardless of
   specificity, so a broad `Button.-style-default` selector clobbers those
   variants' own background instead of leaving them alone.
   Background only, no border override: a compact button (settings dialog's
   Apply/Cancel) forces `border: none !important` in its own DEFAULT_CSS,
   and since app.tcss rules outrank DEFAULT_CSS even through !important, a
   border-top/border-bottom here would put a border back specifically on
   compact gray buttons while their compact -primary sibling stays
   borderless. Leaving border alone keeps both compact and non-compact
   gray buttons consistent with their variant siblings' border handling. */
Button.button-gray {
    background: $surface-lighten-3;

    &:hover {
        background: $surface-lighten-1;
    }
}

/* The same treatment, applied by id: tcw composes its own dialogs, so there
   is no call site here to hang the class on. Theming is the app's job, not
   the library's -- tcw ships layout and leaves colour alone. */
ConfirmScreen #confirm-no,
SettingsScreen #settings-apply,
SettingsScreen #settings-cancel,
MultiPickerScreen #multipicker-cancel {
    background: $surface-lighten-3;

    &:hover {
        background: $surface-lighten-1;
    }
}

/* ---- picker modal ----------------------------------------------------- */

PickerScreen > #dialog,
MultiPickerScreen > #dialog {
    width: 70;
    max-height: 80%;
}

#picker-query {
    margin: 1 0;
}

#picker-results {
    height: auto;
    max-height: 20;
}

/* MultiPickerScreen only: PickerScreen has no button row. */
MultiPickerScreen #buttons {
    margin-top: 1;
}

/* Textual's Button defaults to min-width: 16 even when compact, which is
   more than "All"/"None"/"Ok"/"Cancel" ever need -- four of them plus
   margins came within a few cells of the dialog's own width, leaving no
   visible gap for align-horizontal: right (inherited from DialogScreen) to
   show. Trimmed by 4 to 12, still comfortably wider than the longest label
   ("Cancel") needs. */
MultiPickerScreen #buttons Button {
    min-width: 12;
}

/* ---- connecting modal --------------------------------------------------- */

ConnectingScreen > #dialog {
    width: 46;
    max-width: 100%;
}

#connecting-hint {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
}

/* ---- status footer ---------------------------------------------------- */

StatusFooter .footer-spacer {
    width: 1fr;
    height: 1;
}

StatusFooter #footer-warehouse,
StatusFooter #footer-role {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $footer-description-foreground;
    background: $footer-description-background;
}

StatusFooter #footer-countdown {
    /* Fixed at three digits plus a cell of padding either side, so the
       figures do not shift as the count drops from 3 digits to 2 to 1. */
    width: 5;
    height: 1;
    padding: 0 1;
    text-align: right;
    color: $footer-description-foreground;
    background: $footer-description-background;
}

StatusFooter #footer-pool {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $footer-description-foreground;
    background: $footer-description-background;
}

/* ---- detail pane and views -------------------------------------------- */

#context-bar {
    height: auto;
    padding: 0 1;
}

#context-title {
    text-style: bold;
}

#context-detail {
    color: $text-muted;
}

#detail-summary {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#detail-columns {
    height: 1fr;
}

#detail-placeholder {
    padding: 1 2;
    color: $text-muted;
}

#pipe-problem {
    height: auto;
    padding: 0 1;
    color: $error;
    text-style: bold;
}

#pipe-facts {
    height: auto;
    padding: 1;
}

#pipe-definition-label {
    padding: 0 1;
    text-style: bold;
}

#pipe-definition {
    height: 1fr;
    padding: 0 1;
    color: $text-muted;
}

/* ---- search modal: 90% of the screen, room for a lot of matches -------- */

SearchScreen > #dialog {
    width: 90%;
    height: 90%;
}

SearchScreen #search-query {
    /* Input's default border needs three rows to show anything inside it;
       squeezing that to one row without dropping the border first left the
       text and cursor with nowhere to actually paint. */
    border: none;
    height: 1;
    padding: 0 1;
    background: $panel;
    margin-bottom: 1;
}

SearchScreen #search-results {
    height: 1fr;
}
